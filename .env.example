# === Application ===
APP_NAME=template-rust-api
ENVIRONMENT=development   # development | production

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# === Logging ===
# Semua log selalu JSON (satu record per baris), siap untuk log aggregation.
LOG_LEVEL=info            # debug | info | warn | error
# Optional: when set, every log line is also appended to this file (JSON)
#LOG_FILE=logs/app.log

# === Feature Flags ===
# Turn optional integrations on/off. When disabled, the dependency is never
# initialized and the app runs without it. Status is reported in /health and
# at startup.
REDIS_ENABLED=true
RABBITMQ_ENABLED=true
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LIFETIME_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=30
IDEMPOTENCY_HEADER=Idempotency-Key

# --- Realtime (WebSocket + SSE) & Distributed Bridge ---
# Master switch. When off, both realtime_sse and realtime_ws are forced off.
REALTIME_ENABLED=true
# SSE and WS are independently togglable.
REALTIME_SSE_ENABLED=true      # Server-Sent Events
REALTIME_WS_ENABLED=true       # WebSocket
# Distributed fan-out transport across instances (auto-scaled fleets):
#   redis    -> Redis pub/sub (default, always compatible with the hub)
#   rabbitmq -> RabbitMQ fanout exchange (requires RABBITMQ_ENABLED=true)
#   both     -> publish on Redis AND RabbitMQ
#   local    -> single-instance local in-memory broadcast
# If the backing service for the chosen transport is disabled/missing, the
# hub degrades to single-instance (local) mode instead of failing to boot.
REALTIME_BRIDGE=redis

# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DB_SSLMODE=disable
# Raw override URL if preferred:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db?sslmode=disable

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Raw override URL if preferred:
#REDIS_URL=redis://localhost:6379/0

# === RabbitMQ ===
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Raw override URL if preferred:
#RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# === JWT ===
# IMPORTANT: Change these secrets in production!
# Use at least 32 characters for better security
JWT_ACCESS_SECRET=change-this-to-a-random-secret-key-min-32-characters
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key-min-32-chars
JWT_ACCESS_DURATION=15        # Access token duration in minutes
JWT_REFRESH_DURATION=168      # Refresh token duration in hours (7 days)
JWT_ROTATION_THRESHOLD_DAYS=2 # Rotate refresh token if expiring within N days
JWT_ISSUER=template-rust
COOKIE_SECURE=false           # Set true in production (HTTPS only)

# === OpenTelemetry ===
OTEL_ENABLED=false
OTEL_SERVICE_NAME=template-rust
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2


# === ExaVault Specific Config ===
# 32-byte master key for AES-256-GCM encryption at rest (64 hex characters or passphrase)
EXAVAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminsecret123
APP_URL=http://localhost:3000
